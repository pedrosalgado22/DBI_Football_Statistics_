<a:ManuallyResized>1</a:ManuallyResized>
</o:NoteSymbol>
<o:NoteSymbol Id="o11">
<a:Text>MinutesPlayed, PassesCompleted, ShotsOnTarget and GoalsScored are calculated fields as they can be infered from actions.</a:Text>
<a:CreationDate>1763319778</a:CreationDate>
<a:ModificationDate>1763319796</a:ModificationDate>
<a:Rect>((-76287,52934), (-62399,48000))</a:Rect>
